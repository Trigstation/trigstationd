# Copy this file to .env and edit it. docker compose reads .env automatically.
#
#   cp .env.example .env
#   docker compose up -d

# The domain this directory answers on. Caddy obtains a certificate for it
# automatically, so the domain's A/AAAA records must already point at this host.
# This is the only setting that must be changed.
TRIGSTATION_DOMAIN=directory.example.com

# Where the source of THIS instance can be obtained, published by GET /v1/meta.
#
# Leave it unset if you are running the reference implementation unmodified —
# the default already points at it.
#
# If you have MODIFIED trigstationd, uncomment this and point it at your own
# source. AGPL §13 requires it of anyone who both modifies the software and
# offers it over a network, and this field is how that obligation is discharged.
# It may not be empty; the binary refuses to start if it is.
#TRIGSTATION_SOURCE_URL=https://git.example.com/you/trigstationd
